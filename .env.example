# ⚠️ 以下3つのREACT_APP_SQUARE_*は未使用(Square廃止に伴い隔離。src/legacy/square/でのみ参照される)
REACT_APP_SQUARE_ENV=SANDBOX
REACT_APP_SQUARE_APP_ID=your_square_app_id
REACT_APP_SQUARE_LOCATION_ID=your_location_id

# ⚠️⚠️⚠️ モックスイッチ。本番では以下3つとも必ずfalseにすること(未設定時のデフォルトはtrue)
REACT_APP_USE_MOCK_PAYMENT=false
REACT_APP_USE_MOCK_MENU=false
REACT_APP_USE_TEST_TIME=false